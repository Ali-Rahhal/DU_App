generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DEFAULT_DATABASE_URL")
}

model address {
  address_code     String         @id(map: "PK_addresses") @db.NVarChar(20)
  parent_code      String?        @default("-1", map: "DF_address_parent_code") @db.NVarChar(20)
  alt_description  String?        @db.NVarChar(250)
  description      String?        @db.NVarChar(250)
  address_type_id  Int?           @default(0, map: "DF_address_address_type_id")
  is_active        Boolean        @default(true, map: "DF_address_is_ACTIVE")
  date_added       DateTime       @default(now(), map: "DF_address_date_added")
  last_edited      DateTime       @default(now(), map: "DF_address_last_edited")
  erp_address_code String?        @db.NVarChar(50)
  address_types    address_types? @relation(fields: [address_type_id], references: [address_type_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_addresses_address_types")
}

model address_types {
  address_type_id Int       @id(map: "PK_address_types") @default(autoincrement())
  description     String?   @db.VarChar(50)
  alt_description String    @db.VarChar(50)
  is_Independent  Boolean?  @default(false, map: "DF_address_types_is_Independent")
  date_added      DateTime  @default(now(), map: "DF_address_types_date_added")
  last_edited     DateTime  @default(now(), map: "DF_address_types_last_edited")
